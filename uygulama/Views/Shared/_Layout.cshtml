@{
    var oturum = Context.Items["oturum"] as Yemekhane.Servisler.OturumBilgisi;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Yemekhane</title>
    <link rel="stylesheet" href="/css/temel.css" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header class="ust">
        <div class="kapsayici ust-satir">
            <a class="marka" href="/">Yemekhane</a>
            @if (oturum is not null)
            {
                <form asp-controller="Hesap" asp-action="Cikis" method="post" class="kim">
                        <span>@oturum.Ad</span>
                    <span class="kim-bakiye">@await Component.InvokeAsync("Bakiye", new { oturum })</span>
                    <button type="submit" class="dugme dugme-cikis">Çıkış</button>
                </form>
            }
        </div>
        @if (oturum is not null)
        {
            <nav class="kapsayici ana-menu" aria-label="Ana menü">
                <a href="/">Günün menüsü</a>
                <a href="/Menu/Haftalik">Haftalık menü</a>
                <a href="/Rezervasyon">Rezervasyonlarım</a>
                <a href="/Bakiye">Bakiye</a>
                <a href="/Degerlendirme">Değerlendirme</a>
                @if (oturum.Rol == "yonetici")
                {
                    <a href="/Yonetim">Yönetim</a>
                }
            </nav>
        }
    </header>

    <main class="kapsayici">
            @if (TempData["Basari"] is string basari)
        {
            <p class="bildirim bildirim-basari" role="status">@basari</p>
        }
        @if (TempData["Hata"] is string hata)
        {
            <p class="bildirim bildirim-hata" role="alert">@hata</p>
        }
        @RenderBody()
    </main>

    <footer class="kapsayici alt">Yemekhane Otomasyonu · Web Teknolojileri dönem ödevi</footer>
</body>
</html>