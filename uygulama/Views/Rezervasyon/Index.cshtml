@model List<RezervasyonSatiri>
@{
    ViewData["Title"] = "Rezervasyonlarım";
    string? secili = ViewBag.Durum;
    var durumAdi = new Dictionary<string, string>
    {
        ["aktif"] = "Aktif",
        ["kullanildi"] = "Kullanıldı",
        ["iptal"] = "İptal edildi",
    };
}
<h1>Rezervasyonlarım</h1>

<nav class="sekmeler" aria-label="Duruma göre süz">
    <a asp-action="Index" aria-current="@(secili == null ? "page" : null)">Tümü</a>
    @foreach (var (kod, ad) in durumAdi)
    {
        <a asp-action="Index" asp-route-durum="@kod" aria-current="@(secili == kod ? "page" : null)">@ad</a>
    }
</nav>

@if (Model.Count == 0)
{
    <p class="bildirim">Bu durumda rezervasyon yok.</p>
}

@foreach (var r in Model)
{
    <article class="kart liste-kart">
        <div class="satir">
            <h2>@r.Tarih.ToString("d MMMM dddd") · @r.Ogun</h2>
            <span class="rozet rozet-@r.Durum">@durumAdi[r.Durum]</span>
        </div>
        <p class="soluk">
            @r.Yemekhane · @(r.Porsiyon == "yarim" ? "Yarım porsiyon" : "Tam porsiyon") · Ücret <strong>@r.Ucret.ToString("C")</strong>
        </p>

        @if (r.IptalEdilebilir)
        {
            <form asp-action="Iptal" asp-route-id="@r.Id" method="post" class="satir">
                <button type="submit" class="dugme dugme-ikincil">İptal et</button>
                <span class="soluk">Son iptal saati @r.RezervasyonSon.ToString("HH:mm")</span>
            </form>
        }
        else if (r.Durum == "aktif")
        {
            <p class="soluk">İptal süresi doldu.</p>
        }
        else if (r.Durum == "kullanildi")
        {
            <p class="soluk">Kullanım: @r.KullanmaZamani?.ToString("d MMMM HH:mm")</p>
        }
        else
        {
            <p class="soluk">İptal: @r.IptalZamani?.ToString("d MMMM HH:mm")</p>
        }
    </article>
}
